# WheelBoard API Keys - Example
# Copy this file to .env and fill in your actual values
# WARNING: Never commit .env file to version control!
# NOTE: .env is bundled into the app binary, so every value here is readable
# by anyone who has the app. Only put client-safe values in it.

# Backend API origin, without the /api suffix.
# Release builds MUST use production; a localhost/LAN value ships as-is.
#   Production: https://api.wheelboard.in
#   Local dev:  http://localhost:8000 (iOS Simulator) · http://10.0.2.2:8000 (Android emulator)
API_URL=https://api.wheelboard.in

# Razorpay Keys (Get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
# Never add RAZORPAY_KEY_SECRET here: it is server-only and the app doesn't use it.

# Google Maps API Key (Get from https://console.cloud.google.com)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# WheelBoard Company Logo URL (for Razorpay checkout)
COMPANY_LOGO_URL=https://your-domain.com/images/logo.png
